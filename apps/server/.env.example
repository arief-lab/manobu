# apps/server environment. Copy to .env (gitignored) and fill in.
#
# Two tiers, on purpose:
#   [env]   parsed and validated by @manobu/env/server (packages/env). A bad
#           value fails at boot.
#   [raw]   read directly from process.env at the site named in the comment.
#           Not in the schema: Bun owns BUN_PORT, the other three are resolved
#           before/around module init or are plumbing, not config.
#           Rule and exceptions: packages/env/AGENTS.md.

# --- required ---------------------------------------------------------------
# [env] User database (libSQL). Dev points at the repo-root file; the Tauri
#       sidecar overrides this with the per-user app-data path.
DATABASE_URL=file:../../local.db
# [env] Comma-separated allowed CORS origins. Dev is the Vite origin; the
#       AppImage WebView is loaded under tauri://localhost.
CORS_ORIGIN=http://localhost:3001

# --- optional ---------------------------------------------------------------
# [env] Content database (vocab/grammar/kanji). Default when unset:
#       file:./content.db
# CONTENT_DATABASE_URL=
# [env] Which ACP-speaking CLI to spawn. Unset: packages/acp picks the first of
#       opencode, claude, gemini, codex, copilot on PATH.
# ACP_AGENT_BIN=
# [env] MCP servers attached to every agent session, as
#       "<id>:<stdio|http|sse>:<command-or-url>" entries. Transport-unsupported
#       entries are warn-skipped.
# ACP_MCP_SERVERS=jlpt-vocab:stdio:npx jlpt-mcp@latest
# [env] Host ask_user tool deadline (ms). Default 25 min.
# ASK_TIMEOUT_MS=
# [env] Engine backstop for parked asks and permission cards (ms). Default 30 min.
# CONFIRMATION_TIMEOUT_MS=
# [env] development | production | test. Default development.
# NODE_ENV=

# --- read directly, not validated -------------------------------------------
# [raw] API port. Bun's auto-serve reads this natively; the Tauri sidecar sets
#       it to 4317 (apps/desktop/src-tauri). Do NOT model it as a PORT field in
#       @manobu/env/server: an explicit Bun.serve({port}) broke SSE streaming.
BUN_PORT=4317
# [raw] Japanese corpus + vaporetto model dir. Unset: packages/japanese resolves
#       it from the repo layout (apps/server/src/data-dir.ts).
# MANOBU_DATA_DIR=
# [raw] Persona markdown dir. The loader probes import.meta.dir and cwd
#       before this (apps/server/src/assistant-loader.ts), so dev resolves
#       repo-root/assistant without it; the Tauri sidecar always passes the
#       resolved bundle path explicitly. Unset + missed probes = embedded
#       Sensei fallback.
# MANOBU_ASSISTANT_DIR=
# [raw] Tauri app pid (apps/desktop/src-tauri/src/lib.rs). When set, the
#       sidecar polls it and tears itself down when the parent vanishes, so
#       a kill -9 of the app cannot orphan this backend (TASK-153 AC#2;
#       apps/server/src/parent-watchdog.ts). Unset = watchdog inert.
# MANOBU_PARENT_PID=
# [raw] Explicit cache/log homes passed by the Tauri sidecar (app_cache_dir,
#       app_log_dir). GET /api/system/info reports them; nothing derives a
#       path from cwd (TASK-153 AC#3).
# MANOBU_CACHE_DIR=
# MANOBU_LOG_DIR=
# [raw] Host-tool callback URL and token for the agent to call back into the
#       server (apps/server/src/ask-tool.ts). Unset: host tools are not offered.
# MANOBU_HOST_TOOLS_URL=
# MANOBU_HOST_TOOLS_TOKEN=
# [raw] Path of the ACP child-process registry file used for crash recovery
#       (apps/server/src/context.ts, packages/acp/src/child-registry.ts).
# ACP_CHILD_REGISTRY=
