+// manobu patch (TASK-49, upstream v0.4.0): FTS5 x_create rebuilds the
+// Predictor on EVERY call — one 58MB model parse per CREATE VIRTUAL TABLE
+// and per connection first-use, ~6.5s each, 5 tables = ~33s per connection.
+// Cache predictors globally keyed by their full config; x_create clones the
+// Arc. Single-keyed per config, so differing tags/wsconst never share.
+static PREDICTOR_CACHE: std::sync::Mutex<Option<HashMap<String, Arc<Predictor>>>> =
+    std::sync::Mutex::new(None);
+
+fn cached_predictor(config: &TokenizerConfig) -> Result<Arc<Predictor>, String> {
+    let key = format!(
+        "model={:?}|wsconst={}|tags={:?}|keep_untagged={}|case_sensitive={}",
+        config.model_path, config.wsconst, config.tags, config.keep_untagged, config.case_sensitive
+    );
+    let mut guard = PREDICTOR_CACHE
+        .lock()
+        .map_err(|e| format!("predictor cache poisoned: {e}"))?;
+    if let Some(hit) = guard.as_ref().and_then(|m| m.get(&key)) {
+        return Ok(std::sync::Arc::clone(hit));
+    }
+    let predictor = std::sync::Arc::new(build_predictor(config)?);
+    guard
+        .get_or_insert_with(HashMap::new)
+        .insert(key, std::sync::Arc::clone(&predictor));
+    Ok(predictor)
+}
